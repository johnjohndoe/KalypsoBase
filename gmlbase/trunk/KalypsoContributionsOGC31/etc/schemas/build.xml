<?xml version="1.0" encoding="UTF-8" ?>

<project name="KalypsoContributionsOGC-binding" default="generate">

	<property name="project" value="${workspace}/KalypsoContributionsOGC31" />

	<description>Erzeugt die Binding-Klassen aus den Schemata</description>

	<patternset id="binding.schemata">
		<include name="etc/schemas/generated/**/*.xsd" />
	</patternset>

	<import file="${workspace}/KalypsoBuild/common-binding/build.xml" />
		
	<target name="prepareSchemas">
		<delete>
			<fileset dir="${project}/etc/schemas/generated" id="idjh">
    			<include name="**/*.xsd"/>
			</fileset>
		</delete>
		<xslt style="generateSchemas.xsl" destdir="generated" basedir="${project}/etc/schemas/original" extension=".xsd" >
		    <include name="**/*.xsd"/>
		</xslt>
		
	</target>
</project>

