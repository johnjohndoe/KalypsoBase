<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:ksp="http://www.ksp.org/om" xmlns:xs="http://www.w3.org/2001/XMLSchema"
     xmlns:gml="http://www.opengis.net/gml" xmlns:om="http://www.opengis.net/om"
     xmlns:swe="http://www.opengis.net/swe" xmlns:xlink="http://www.w3.org/1999/xlink"
     targetNamespace="http://www.ksp.org/om">
    
     <xs:annotation>
          <xs:appinfo xmlns:kapp="org.kalypso.appinfo">
               <kapp:gmlVersion>3.1.1</kapp:gmlVersion>
          </xs:appinfo>
     </xs:annotation>
    
     <xs:import namespace="http://www.opengis.net/gml" schemaLocation="../gml/3.1.1/base/gml.xsd"/>
     <xs:import namespace="http://www.opengis.net/om" schemaLocation="../om/1.0.30/om.xsd"/>
     <xs:import namespace="http://www.opengis.net/swe" schemaLocation="../sweCommon/1.0.30/swe.xsd"/>
     <xs:import namespace="http://www.w3.org/1999/xlink" schemaLocation="../xlink/1.0.0/xlinks.xsd"/>

     <xs:element name="metaData" type="ksp:MetaDataType"/>

     <xs:complexType name="MetaDataType">
          <xs:sequence>
               <xs:element name="name" type="xs:string"/>
               <xs:element name="value">
                    <xs:complexType>
                         <xs:complexContent>
                              <xs:extension base="xs:anyType">
                                   <xs:attribute name="type" use="optional">
                                        <xs:annotation>
                                             <xs:documentation>Wenn kein type angegeben wird, wird
                                                  der value-Inhalt als String
                                             gewertet</xs:documentation>
                                        </xs:annotation>
                                   </xs:attribute>
                              </xs:extension>
                         </xs:complexContent>
                    </xs:complexType>
               </xs:element>
          </xs:sequence>
     </xs:complexType>

     <xs:element name="profile" type="ksp:ProfileType" substitutionGroup="om:AbstractObservation"/>

     <xs:complexType name="ProfileType">
          <xs:annotation>
               <xs:documentation>Wir definieren einen eigenen Observation Typ für Querprofile. Damit
                    wird die Stationierung direkt im Schema berücksichtigt: die Stationierung wird
                    konsequent benutzt um Querprofil zu bearbeiten. Wir packen deswegen diese
                    Information als Element und nicht als Metadata. Ein Querprofil leitet von
                    CommonObservation ab und beinhaltet also die Tupeln. Sie werden anhand von
                    resultDefinition angegeben. Für die zusätzliche Durchlässe, Maulprofile, Kreise
                    und Trapezen wird das Element member definiert.</xs:documentation>
          </xs:annotation>
          <xs:complexContent>
               <xs:extension base="om:ObservationType">
                    <xs:sequence>
                         <xs:element name="profileStation" type="swe:RelativeMeasureType"
                              minOccurs="1" maxOccurs="1">
                              <xs:annotation>
                                   <xs:documentation>Die Profilstationierung, wichtiger Bestandteil
                                        für die Bearbeitung von Querprofile.</xs:documentation>
                              </xs:annotation>
                         </xs:element>
                         <xs:element name="profileMember" type="om:AbstractObservationPropertyType"
                              minOccurs="0" maxOccurs="unbounded">
                              <xs:annotation>
                                   <xs:documentation>Die Liste der zusätzliche Observations: z.B.
                                        Durchlässe, Maulprofile, Kreise und Trapezen können hiermit
                                        abgebildet werden.</xs:documentation>
                              </xs:annotation>
                         </xs:element>
                    </xs:sequence>
               </xs:extension>
          </xs:complexContent>
     </xs:complexType>

</xs:schema>
