<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="org.kalypso.chart.ui.editor.ChartEditor"
            default="true"
            extensions="kod"
            icon="icons/obj16/kalypso_odt.gif"
            id="org.kalypso.chart.ui.editor.ChartEditor"
            name="Chart Editor"/>
   </extension>
   <extension
         point="org.eclipse.ui.editorActions">
      <editorContribution
            id="org.kalypso.chart.ui.editor.ChartEditorContribution"
            targetID="org.kalypso.chart.ui.editor.ChartEditor">
         <menu
               id="org.kalypso.chart.ui.menu"
               label="&amp;Chart"
               path="additions">
            <groupMarker name="actions"/>
         </menu>
         <action
               class="org.kalypso.chart.ui.editor.actions.MaximizeActionDelegate"
               icon="icons/elcl16/chart_maximize.gif"
               id="org.kalypso.chart.ui.actions.maximize"
               label="&amp;Maximize"
               menubarPath="org.kalypso.chart.ui.menu/actions"
               style="push"
               toolbarPath="actions"
               tooltip="Maximize Chart"/>
         <action
               class="org.kalypso.chart.ui.editor.actions.ZoomInActionDelegate"
               icon="icons/elcl16/chart_zoomin.gif"
               id="org.kalypso.chart.ui.actions.zoomIn"
               label="&amp;Zoom In"
               menubarPath="org.kalypso.chart.ui.menu/actions"
               style="radio"
               toolbarPath="actions"
               tooltip="Zoom in">
         </action>
         <action
               class="org.kalypso.chart.ui.editor.actions.ZoomOutActionDelegate"
               icon="icons/elcl16/chart_zoomout.gif"
               id="org.kalypso.chart.ui.actions.zoomOut"
               label="&amp;ZoomOut"
               menubarPath="org.kalypso.chart.ui.menu/actions"
               style="radio"
               toolbarPath="actions"
               tooltip="Zoom out">
         </action>
         <action
               class="org.kalypso.chart.ui.editor.actions.PanActionDelegate"
               icon="icons/elcl16/chart_pan.gif"
               id="org.kalypso.chart.ui.actions.pan"
               label="&amp;Pan"
               menubarPath="org.kalypso.chart.ui.menu/actions"
               style="radio"
               toolbarPath="actions"
               tooltip="Pan">
         </action>
         <action
               class="org.kalypso.chart.ui.editor.actions.EditActionDelegate"
               icon="icons/elcl16/chart_edit.gif"
               id="org.kalypso.chart.ui.actions.edit"
               label="&amp;Edit"
               menubarPath="org.kalypso.chart.ui.menu/actions"
               style="toggle"
               toolbarPath="actions"
               tooltip="Edit">
         </action>
         <action
               class="org.kalypso.chart.ui.editor.actions.ExportActionDelegate"
               icon="icons/elcl16/chart_save.gif"
               id="org.kalypso.chart.ui.actions.exportImage"
               label="&amp;Export"
               menubarPath="org.kalypso.chart.ui.menu/actions"
               style="push"
               toolbarPath="actions"
               tooltip="Export as image">
         </action>
      </editorContribution>
   </extension>
   <extension
         point="org.eclipse.ui.views">
      <view
            allowMultiple="false"
            category="org.kalypso.ui.kalypso"
            class="org.kalypso.chart.ui.view.ChartView"
            id="org.kalypso.chart.ui.view.ChartView"
            name="Chart View">
      </view>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <category
            id="org.kalypso.chart.ui.commands.category"
            name="ChartUI commands">
      </category>
      <command
            categoryId="org.kalypso.chart.ui.commands.category"
            defaultHandler="org.kalypso.chart.ui.editor.handler.PanHandler"
            id="org.kalypso.chart.ui.commands.pan"
            name="Pan">
      </command>
      <command
            categoryId="org.kalypso.chart.ui.commands.category"
            defaultHandler="org.kalypso.chart.ui.editor.handler.ZoomInHandler"
            id="org.kalypso.chart.ui.commands.zoomIn"
            name="Zoom in">
      </command>
      <command
            categoryId="org.kalypso.chart.ui.commands.category"
            defaultHandler="org.kalypso.chart.ui.editor.handler.ZoomOutHandler"
            id="org.kalypso.chart.ui.commands.zoomOut"
            name="Zoom out">
      </command>
      <command
            categoryId="org.kalypso.chart.ui.commands.category"
            defaultHandler="org.kalypso.chart.ui.editor.handler.EditHandler"
            id="org.kalypso.chart.ui.commands.edit"
            name="Edit">
      </command>
      <command
            categoryId="org.kalypso.chart.ui.commands.category"
            defaultHandler="org.kalypso.chart.ui.editor.handler.MaximizeHandler"
            id="org.kalypso.chart.ui.commands.maximize"
            name="Maximize">
      </command>
      <command
            categoryId="org.kalypso.chart.ui.commands.category"
            defaultHandler="org.kalypso.chart.ui.editor.handler.ExportHandler"
            id="org.kalypso.chart.ui.commands.export"
            name="Export">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.commandImages">
   </extension>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            commandId="KalypsoChartUi.handler6">
         <enabledWhen>
            <with
                  variable="part">
            </with>
         </enabledWhen>
      </handler>
   </extension>

</plugin>
