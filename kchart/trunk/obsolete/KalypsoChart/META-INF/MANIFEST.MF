Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: KalypsoChart Plug-in
Bundle-SymbolicName: org.kalypso.chart; singleton:=true
Bundle-Version: 1.0.0
Bundle-Activator: org.kalypso.swtchart.KalypsoChartPlugin
Bundle-Vendor: kalypso.org
Bundle-Localization: plugin
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.kalypso.contribs.eclipsercp,
 org.kalypso.commons,
 org.kalypso.jwsdp
Eclipse-AutoStart: true
Export-Package: org.kalypso.swtchart,
 org.kalypso.swtchart.chart,
 org.kalypso.swtchart.chart.axis,
 org.kalypso.swtchart.chart.axis.component,
 org.kalypso.swtchart.chart.axis.registry,
 org.kalypso.swtchart.chart.axis.renderer,
 org.kalypso.swtchart.configuration,
 org.kalypso.swtchart.chart.layer,
 org.kalypso.swtchart.chart.layer.impl,
 org.kalypso.swtchart.chart.legend,
 org.kalypso.swtchart.chart.styles,
 org.kalypso.swtchart.chart.util,
 org.kalypso.swtchart.chart.view,
 org.ksp.chart.layerstyle,
 org.ksp.chart.viewerconfiguration
Bundle-ClassPath: kalypsoChart.jar
