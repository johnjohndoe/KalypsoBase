<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
     targetNamespace="http://www.ksp.org/chart/tableConfiguration"
     xmlns:kctc="http://www.ksp.org/chart/tableConfiguration" elementFormDefault="qualified" >

<element name="Table" type="kctc:TableType"/>

<complexType name="TableType">
     <annotation>
          <documentation>
               definiert die Spalten einer Tabelle, die als HTML-Tabelle vom ODS abgerufen werden kann
          </documentation>
     </annotation>
	<sequence>
		<element name="Title" type="string" minOccurs="0"/>
		<element name="Abstract" type="string" minOccurs="0"/>
	     <element name="DataSource" type="anyURI" >
	          <annotation>
	               <documentation>
	                    die URL oder der Dateipfad zur Quellobservation
	               </documentation>
	          </annotation>
	     </element>
	     <element name="Observation" type="kctc:ObservationType">
	          <annotation>
	               <documentation>
	                    Hier wird die Observation angegeben, deren Ergebnis in der Tabelle erscheinen soll;
	                    am besten durch eine Id, muss aber noch geprüft werden.(TODO)
	               </documentation>
	          </annotation>
	     </element>
	     <element name="Component" type="kctc:ComponentType" maxOccurs="unbounded">
	          <annotation>
	               <documentation>
	                    Eine Component ist eine Spalte, die in der Tabelle angezeigt werden soll.
	               </documentation>
	          </annotation>
	     </element>
	     <element name="Class" type="string" minOccurs="0">
	          <annotation>
	               <documentation>
	                    Name der CSS-Klasse, die für die Tabelle verwendet wird; dieser Parameter
	                    zeigt seine Wirkung nur in Verbindung mit einem entsprechenden CSS-Style,
	                    der im HTML-Dokument referenziert wird
	               </documentation>
	          </annotation>
	     </element>
	</sequence>
	<attribute name="name" type="ID" use="required"></attribute>
</complexType>

     <complexType name="ObservationType">
          <annotation>
               <documentation>
                    TODO: Überprüfen, wie sich eine Observation am idealsten Beschreiben lässt
               </documentation>
          </annotation>
          <sequence>
               <element name="Id" type="string"></element>
          </sequence>
          
     </complexType>


     <complexType name="ComponentType">
          <sequence>
               <element name="ItemID" type="string" minOccurs="1" maxOccurs="1">
                    <annotation>
                         <documentation>
                             Über die Item-ID wird die gewünschte Spalte des ObservationResults definiert.
                             die Item-ID entspricht der id des ResultItem in der ResultDefinition
                         </documentation>
                    </annotation>
               </element>
               <element name="ComponentClass" type="string" minOccurs="0" maxOccurs="1">
                    <annotation>
                         <documentation>
                              Name der CSS-Klasse, die für die Komponente verwendet wird; dieser Parameter
                              zeigt seine Wirkung nur in Verbindung mit einem entsprechenden CSS-Style,
                              der im HTML-Dokument referenziert wird
                         </documentation>
                    </annotation>
               </element>
               <element name="Header" type="string" minOccurs="0" maxOccurs="1">
                    <annotation>
                         <documentation>
                              Der optionale Header wird in der Kopfzeile der Tabelle angezeigt. Wird er nicht
                              angegeben, wird der Eintrag im Name-Feld des ResultItems verwendet
                         </documentation>
                    </annotation>
               </element>
               <element name="HeaderClass" type="string" minOccurs="0" maxOccurs="1">
                    <annotation>
                         <documentation>
                              Name der CSS-Klasse, die für die HeaderZeile verwendet wird; dieser Parameter
                              zeigt seine Wirkung nur in Verbindung mit einem entsprechenden CSS-Style,
                              der im HTML-Dokument referenziert wird
                         </documentation>
                    </annotation>
               </element>
          </sequence>
     </complexType>

</schema>