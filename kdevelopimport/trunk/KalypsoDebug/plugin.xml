<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin
   id="org.kalypso.debug"
   name="KalypsoDebug Plug-in"
   version="1.0.0"
   provider-name="kalypso.org"
   class="org.kalypso.debug.KalypsoDebugPlugin">

   <runtime>
      <library name="KalypsoDebug.jar">
         <export name="*"/>
      </library>
      <library name="lib/debugBinding.jar">
         <export name="*"/>
      </library>
   </runtime>

   <requires>
      <import plugin="org.eclipse.ui"/>
      <import plugin="org.eclipse.core.runtime"/>
      <import plugin="org.kalypso.ui"/>
      <import plugin="org.kalypso.jwsdp"/>
      <import plugin="org.kalypso.contribs.eclipseplatform"/>
   </requires>
   <extension
         point="org.eclipse.ui.views">
      <category
            name="Kalypso Debug"
            id="org.kalypso.view.debug"/>
      <view
            allowMultiple="false"
            class="org.kalypso.debug.view.PoolView"
            category="org.kalypso.view.debug"
            name="Resource Pool"
            id="org.kalypso.debug.view.pool"/>
   </extension>
   <extension
         point="org.eclipse.ui.editors">
      <editor
            launcher="org.kalypso.debug.editor.GmlConvertLauncher"
            default="false"
            name="GML Converter"
            id="org.kalypso.debug.editor.gmlconvert"
            extensions="gmc"/>
   </extension>
   <extension
         point="org.eclipse.ui.actionSets">
      <actionSet
            label="Kalypso Debug"
            description="Aktionen zum Debuggen von Kalypso"
            visible="true"
            id="org.kalypso.actionSet.debug">
         <menu
               label="Kalypso Debug"
               path="org.kalypso.menu.calcCase"
               id="org.kalypso.menu.debug">
            <groupMarker name="start"/>
         </menu>
         <action
               label="Berechnung(en) testen"
               class="org.kalypso.debug.action.TestCalculationDelegate"
               tooltip="Berechnet die selektierte(n) Rechenvariante(n) und vergleicht das Ergebnis mit dem soll-Zustand."
               style="push"
               menubarPath="org.kalypso.menu.debug/start"
               id="org.kalypso.action.debug.testCalcCase"/>
      </actionSet>
   </extension>

</plugin>
