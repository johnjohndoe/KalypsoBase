Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: MetaProject Plug-in
Bundle-SymbolicName: org.kalypso.metaproject; singleton:=true
Bundle-Version: 1.0.0
Bundle-ClassPath: lib/commons-io-1.0.jar,
 build/bin
Bundle-Activator: org.kalypso.metaproject.MetaProjectPlugin
Bundle-Vendor: kalypso.org
Bundle-Localization: plugin
Export-Package: org.apache.commons.io,
 org.apache.commons.io.filefilter,
 org.apache.commons.io.input,
 org.apache.commons.io.output,
 org.kalypso.metaproject,
 org.kalypso.metaproject.views
Require-Bundle: org.eclipse.ui,
 org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.kalypso.contribs.eclipseplatform
Eclipse-LazyStart: true
