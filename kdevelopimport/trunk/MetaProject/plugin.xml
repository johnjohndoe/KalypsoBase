<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin
   id="org.kalypso.metaproject"
   name="MetaProject Plug-in"
   version="1.0.0"
   provider-name="kalypso.org"
   class="org.kalypso.metaproject.MetaProjectPlugin">

   <runtime>
      <library name="MetaProject.jar">
         <export name="*"/>
      </library>
      <library name="lib/commons-io-1.0.jar">
         <export name="*"/>
      </library>
   </runtime>

   <requires>
      <import plugin="org.eclipse.ui"/>
      <import plugin="org.eclipse.core.runtime"/>
      <import plugin="org.eclipse.core.resources"/>
      <import plugin="org.eclipse.ui.ide"/>
   </requires>

   <extension
         point="org.eclipse.ui.views">
      <category
            name="Meta-Information"
            id="org.kalypso.metainfo"/>
      <view
            name="ProjectDependencies"
            icon="icons/tree.gif"
            category="org.kalypso.metainfo"
            class="org.kalypso.metaproject.views.ProjectsView"
            id="org.kalypso.metaproject.views.ProjectsView">
      </view>
      <view
            name="Extensions and ExtensionPoins"
            icon="icons/extpoints.gif"
            category="org.kalypso.metainfo"
            class="org.kalypso.metaproject.views.ExtensionsView"
            id="org.kalypso.metaproject.views.ExtensionsView">
      </view>
   </extension>

</plugin>
