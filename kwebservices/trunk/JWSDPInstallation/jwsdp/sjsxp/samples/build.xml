<?xml version="1.0" encoding="UTF-8"?>
<project name="sjsxp-samples" default="all" basedir=".">

<!-- This default value works with the distribution of SJSXP(Stax Impl.) as part of JWSDP -->
<property name="lib/sjsxp.jar" value="../lib/sjsxp.jar"/>

<!-- This default value works with the distribution of SJSXP(Stax Impl.) as part of JWSDP -->
<property name="stax.api.jar" value="../lib/jsr173_api.jar"/>

<!-- This default value works with the distribution of SJSXP(Stax Impl.) as part of JWSDP -->
<property name="data.dir" value="${basedir}/data"/>

<!-- This default value works with the distribution of SJSXP(Stax Impl.) as part of JWSDP -->
<property name="src.dir" value="${basedir}"/>

<!-- This default value works with the distribution of SJSXP(Stax Impl.) as part of JWSDP -->
<property name="dest.dir" value="${basedir}/build/classes"/>

<property name="my.classpath" value="${dest.dir}:${stax.api.jar}:${lib/sjsxp.jar}"/>

    <target name="all" depends="cursor.CursorParse, event.EventParse, readnwrite.EventProducerConsumer, 
                                cursor2event.CursorApproachEventObject, writer.CursorWriter, filter.MyStreamFilter"/>            
    
    <target name="compile">    
        <mkdir dir="${dest.dir}"/>
        <javac srcdir="${src.dir}"  destdir="${dest.dir}" classpath="${my.classpath}"/>
    </target>
    
    <target name="cursor.CursorParse" depends="compile">
        <echo message=" Running CursorParse Sample."/>
        <java failOnError="true" dir="${dest.dir}" classname="cursor.CursorParse" classpath="${my.classpath}" fork="true">
            <arg value="-x"/>
            <arg value="1"/>
            <arg value="${data.dir}/BookCatalogue.xml"/>
        </java>
    </target>

    <target name="event.EventParse" depends="compile">
        <echo message="Current directory is ${basedir}"/>
        <echo message=" Running EventParse Sample."/>
        <java failOnError="true" dir="${dest.dir}" classname="event.EventParse" classpath="${my.classpath}" fork="true">
            <arg value="${data.dir}/BookCatalogue.xml"/>
        </java>
    </target>

    <target name="readnwrite.EventProducerConsumer" depends="compile">        
        <echo message=" Running readnwrite.EventProducerConsumer Sample."/>
        <java failOnError="true" dir="${dest.dir}" classname="readnwrite.EventProducerConsumer" classpath="${my.classpath}" fork="true">
            <arg value="${data.dir}/BookCatalogue.xml"/>
        </java>
    </target>

    <target name="cursor2event.CursorApproachEventObject" depends="compile">        
        <echo message=" Running cursor2event.CursorApproachEventObject Sample."/>
        <java failOnError="true" dir="${dest.dir}" classname="cursor2event.CursorApproachEventObject" classpath="${my.classpath}" fork="true">
            <arg value="${data.dir}/BookCatalogue.xml"/>
        </java>
    </target>
            
    <target name="writer.CursorWriter" depends="compile">
        <echo message=" Running CursorWriter Sample. Output will be written to ${basedir}/CursorWriter-Output file."/>
        <java failOnError="true" dir="${dest.dir}" classname="writer.CursorWriter" classpath="${my.classpath}" fork="true">
            <arg value="-f"/>
            <!-- Output file name -->
            <arg value="${basedir}/CursorWriter-Output"/>            
        </java>
    </target>
    
    <target name="filter.MyStreamFilter" depends="compile">
        <echo message=" Running StreamFP Sample."/>
        <java failOnError="true" dir="${dest.dir}" classname="filter.MyStreamFilter" classpath="${my.classpath}" fork="true">
            <arg value="-f"/>            
            <arg value="${data.dir}/BookCatalogue.xml"/>            
        </java>
    </target>
        
</project>
