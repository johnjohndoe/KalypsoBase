<project name="api-sample" default="usage" basedir=".">

  <!-- Values in build.properties (if any) override the values in this file -->
  <property file="build.properties"/>
  <property file="../build.properties"/>
  
  <property name="client-class" value="com.sun.wss.sample.Client"/>
  <property name="build.home" value="build"/>

  <target name="compile-client" 
          description="Compiles the client-side source code">
    <echo message="Compiling the client source code...."/>
    <mkdir dir="${build.home}" />
    <mkdir dir="${build.home}/classes" />
    <javac srcdir="."
           debug="true"
           destdir="${build.home}/classes"
           includes="**/*.java">
      <classpath>
         <fileset dir="${jwsdp.home}/xws-security/lib">
            <include name="*.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/saaj/lib">
            <include name="*.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/xmldsig/lib">
            <include name="*.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/jwsdp-shared/lib">
            <include name="*.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/fastinfoset/lib">
            <include name="*.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/jaxp/lib">
            <include name="*.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/jaxp/lib/endorsed">
            <include name="*.jar"/>
        </fileset>
        <pathelement location="${build.home}/classes"/>
      </classpath>
    </javac>
  </target>

  <target name="run-sample" 
          depends="clean, compile-client"
          description="Runs the example client">
    <echo message="Running the ${client-class} program...."/>
    <java fork="on" classname="${client-class}">
       <sysproperty key="jwsdp.home" value="${jwsdp.home}"/>
       <sysproperty key="client.configfile" value="${client.configfile}"/>
       <sysproperty key="server.configfile" value="${server.configfile}"/>
       <sysproperty key="java.endorsed.dirs" value="${jwsdp.home}/jaxp/lib/:${jwsdp.home}/jaxp/lib/endorsed"/>
      <classpath>
         <fileset dir="${jwsdp.home}/xws-security/lib">
            <include name="xws-security.jar"/>
            <include name="xws-saml.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/saaj/lib">
            <include name="saaj-api.jar"/>
            <include name="saaj-impl.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/xmldsig/lib">
            <include name="xmldsig.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/jwsdp-shared/lib">
            <include name="*.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/fastinfoset/lib">
            <include name="FastInfoset.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/jaxp/lib">
            <include name="*.jar"/>
        </fileset>
         <fileset dir="${jwsdp.home}/jaxp/lib/endorsed">
            <include name="*.jar"/>
        </fileset>
        <pathelement location="${build.home}/classes"/>
      </classpath>
    </java>
  </target>

  <target name="clean"
          description="Removes all build and dist directories">
    <delete dir="${build.home}"/>
  </target>

  <target name="usage" >
    <echo message="Please see README.txt for more info."/>
    <echo message="Useful targets:"/>
    <echo message="  clean = clean "/>
    <echo message="  compile-client = build client app code"/>
    <echo message="  run-sample = run the sample"/>
  </target>
  <target name="help" depends="usage"/>

</project>
