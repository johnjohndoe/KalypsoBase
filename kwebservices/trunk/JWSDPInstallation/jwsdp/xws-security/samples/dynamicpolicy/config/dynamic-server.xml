<xwss:JAXRPCSecurity xmlns:xwss="http://java.sun.com/xml/ns/xwss/config">

    <xwss:Service>
         <!-- the exact policy to apply will be decided by the SecurityEnvironmentHandler at runtime -->
        <xwss:SecurityConfiguration dumpMessages="true" enableDynamicPolicy="true">
 
            <!-- sender setting is empty -->
            <!-- sender setting will be obtained dynamically from the SecurityEnvironmentHandler at runtime -->

            

            <!-- the exact receiver settings to apply will be decided by the SecurityEnvironmentHandler at runtime -->

            <!-- target will be obtained dynamically -->
            <!-- In case of DynamicPolicy default target BODY won't be applied here -->
            <xwss:RequireSignature/>

            <!-- target will be obtained dynamically -->
            <!-- In case of DynamicPolicy default target BODY won't be applied here -->
            <xwss:RequireEncryption/>

            <!-- passwordDigestRequired flag value will be changed dynamically -->
            <xwss:RequireUsernameToken passwordDigestRequired="false"/>
        </xwss:SecurityConfiguration>
   </xwss:Service>

    <xwss:SecurityEnvironmentHandler>
        sample.ServerSecurityEnvironmentHandler
    </xwss:SecurityEnvironmentHandler>

</xwss:JAXRPCSecurity>
