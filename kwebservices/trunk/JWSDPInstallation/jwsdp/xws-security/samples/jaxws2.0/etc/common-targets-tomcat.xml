<property name="path" value="jaxws-${ant.project.name}"/>  

<property name="ant.jar"
            value="${tomcat.home}/server/lib/catalina-ant.jar"/>
            
<path id="ant.task.classpath">
    <pathelement location="${ant.jar}"/>
</path>

<taskdef name="deploy-catalina" classname="org.apache.catalina.ant.DeployTask"
             classpathref="ant.task.classpath"/>

 <taskdef name="undeploy-catalina" classname="org.apache.catalina.ant.UndeployTask"
         classpathref="ant.task.classpath"/>

<path id="jaxws.classpath">
    <pathelement location="${tomcat.home}/sjsxp/lib/sjsxp.jar"/>
    <pathelement location="${java.home}/../lib/tools.jar"/>
    <pathelement location="${tomcat.home}/xws-security/lib/xws-security.jar"/>
    <pathelement location="${tomcat.home}/xws-security/lib/xws-security_jaxrpc.jar"/>
    <pathelement location="${tomcat.home}/jwsdp-shared/lib/xmlsec.jar"/>
    <pathelement location="${tomcat.home}/xmldsig/lib/xmldsig.jar"/>
    <pathelement location="${tomcat.home}/jwsdp-shared/lib/activation.jar"/>
    <pathelement location="${tomcat.home}/fastinfoset/lib/FastInfoset.jar"/>
    <pathelement location="${tomcat.home}/jaxb/lib/jaxb-api.jar"/>
    <pathelement location="${tomcat.home}/jaxb/lib/jaxb-impl.jar"/>
    <pathelement location="${tomcat.home}/jaxb/lib/jaxb-libs.jar"/>
    <pathelement location="${tomcat.home}/jaxb/lib/jaxb-xjc.jar"/>
    <pathelement location="${tomcat.home}/jaxws/lib/jaxws-api.jar"/>
    <pathelement location="${tomcat.home}/jaxws/lib/jaxws-rt.jar"/>
    <pathelement location="${tomcat.home}/jaxws/lib/jaxws-tools.jar"/>
    <pathelement location="${tomcat.home}/sjsxp/lib/jsr173_api.jar"/>
    <pathelement location="${tomcat.home}/jaxws/lib/jsr181-api.jar"/>
    <pathelement location="${tomcat.home}/jaxws/lib/jsr250-api.jar"/>
    <pathelement location="${tomcat.home}/saaj/lib/saaj-api.jar"/>
    <pathelement location="${tomcat.home}/saaj/lib/saaj-impl.jar"/>
    <pathelement location="${tomcat.home}/jaxp/lib/jaxp-api.jar"/>
    <pathelement location="${tomcat.home}/jwsdp-shared/lib/mail.jar"/>
    <pathelement location="${tomcat.home}/jwsdp-shared/lib/resolver.jar"/>
    <pathelement location="${tomcat.home}/jwsdp-shared/lib/relaxngDatatype.jar"/>
    <pathelement location="${lib.sample.home}/jaxwsSampleUtils.jar"/>
    <fileset dir="${tomcat.home}/common/lib">
          <include name="*.jar"/>
      </fileset>
    <fileset dir="${tomcat.home}/jaxp/lib/endorsed">
          <include name="*.jar"/>
    </fileset>
</path>

<taskdef name="wsimport" classname="com.sun.tools.ws.ant.WsImport">
    <classpath refid="jaxws.classpath"/>
</taskdef>

<taskdef name="wsgen" classname="com.sun.tools.ws.ant.WsGen">
    <classpath refid="jaxws.classpath"/>
</taskdef>

<taskdef name="apt" classname="com.sun.tools.ws.ant.Apt">
    <classpath refid="jaxws.classpath"/>
</taskdef>

