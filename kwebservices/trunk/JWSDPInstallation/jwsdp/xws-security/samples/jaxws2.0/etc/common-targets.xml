    <pathelement location="${sjsas.home}/lib/activation.jar"/>
    <pathelement location="${sjsas.home}/lib/FastInfoset.jar"/>
    <pathelement location="${sjsas.home}/lib/http.jar"/>
    <pathelement location="${sjsas.home}/lib/jaxb-api.jar"/>
    <pathelement location="${sjsas.home}/lib/jaxb-impl.jar"/>
    <pathelement location="${sjsas.home}/lib/jaxb-libs.jar"/>
    <pathelement location="${sjsas.home}/lib/jaxb-xjc.jar"/>
    <pathelement location="${sjsas.home}/lib/jaxws-api.jar"/>
    <pathelement location="${sjsas.home}/lib/jaxws-rt.jar"/>
    <pathelement location="${sjsas.home}/lib/jaxws-tools.jar"/>
