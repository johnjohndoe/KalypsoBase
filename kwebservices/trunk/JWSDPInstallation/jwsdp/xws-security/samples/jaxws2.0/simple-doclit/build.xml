<!DOCTYPE project [
<!ENTITY as SYSTEM "file:../etc/common-targets.xml">
<!ENTITY tomcat SYSTEM "file:../etc/common-targets-tomcat.xml">
<!ENTITY targets SYSTEM "file:../etc/targets.xml">
]>

<project basedir="." default="help" name="simple">

    <property file="${basedir}/etc/build.properties" />
    <property file="${basedir}/../../build.properties" />
    &targets;

    <target name="run-sample">
        <echo>RUN SAMPLE</echo>
        <antcall target="server" />
        <sleep seconds="60"/>
        <antcall target="client" />
        <antcall target="run" />
    </target>


</project>
